# ── Secrets ───────────────────────────────────────────────────────────────
.env

# ── Virtual environment ───────────────────────────────────────────────────
venv/

# ── SQLite databases & journal files ─────────────────────────────────────
# Generated at runtime — contains checkpointer state & customer data.
# The .db-shm and .db-wal files are SQLite WAL-mode journal artifacts.
*.db
*.db-shm
*.db-wal

# ── Python bytecode & caches ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ── Distribution / packaging ──────────────────────────────────────────────
*.egg
*.egg-info/
dist/
build/
wheels/
.eggs/
MANIFEST

# ── Test & coverage artifacts ─────────────────────────────────────────────
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
nosetests.xml
coverage.xml
*.cover

# ── Type checking ─────────────────────────────────────────────────────────
.mypy_cache/
.pytype/
.pyre/

# ── Uvicorn / FastAPI ─────────────────────────────────────────────────────
# Reload watchdog state
.uvicorn_reload

# ── Frontend build artifacts ──────────────────────────────────────────────
# Uncomment these if you ever add a JS build step (npm/vite/webpack etc.)
# frontend/node_modules/
# frontend/dist/
# frontend/.cache/
# frontend/.parcel-cache/

# ── IDE & editor files ────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# ── OS noise ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
